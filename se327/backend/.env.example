PORT=3000
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-frontend.example.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=core_co

# Supabase storage for product images. Set all three, or images stay on local disk.
# The bucket must be public, and the key is the service role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Core&Co <your_email@gmail.com>"
# Base URL used for links inside emails (required)
WEBSTORE_BASE_URL=http://localhost:8080
# Optional: MAIL_BRAND_NAME, SUPPORT_EMAIL, MAIL_LOGO_URL, MAIL_LOGO_PATH
