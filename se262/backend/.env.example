PORT=3000

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-frontend.example.com

# Database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=core_co

# Supabase
SUPABASE_URL= supabase url from your project
SUPABASE_SECRET_KEY= secret key from your project
SUPABASE_BUCKET= bucket name

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password #(this is from creating an app password from your google account krub)
MAIL_FROM="Core&Co <your_email@gmail.com>"
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=15
WEBSTORE_BASE_URL=http://localhost:8080

# Optional email branding
MAIL_BRAND_NAME=Core&Co
SUPPORT_EMAIL=support@example.com
MAIL_LOGO_URL=
MAIL_LOGO_PATH=
