<%- include('./colorMap') %>
<section class="new-arrivals">
    <div class="section-header">
        <h2>New Arrivals</h2>
        <a href="/products?sort=newest" class="view-all">View All</a>
    </div>

    <div class="product-grid">
        <% products.forEach(function(product) { %>
            <%- include('productCard', { product: product }) %>
                <% }); %>
    </div>
</section>
