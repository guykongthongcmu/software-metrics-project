<%
  const formatProfileDate = (value) => {
    if (!value) return 'Not provided';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return 'Not provided';
    return parsed.toLocaleDateString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  };

  const profileName = profile && profile.name ? profile.name : 'Guest User';
  const profileEmail = profile && profile.email ? profile.email : 'guest@example.com';
  const profilePhone = profile && profile.phone ? profile.phone : 'Not provided';
  const profileInitials = profile && profile.initials ? profile.initials : 'CC';
  const joinedLabel = formatProfileDate(profile && profile.joinedAt);
  const birthdayLabel = formatProfileDate(profile && profile.birthday);
%>

<section class="profile-shell">
  <div class="profile-hero">
    <div class="profile-hero-copy">
      <p class="profile-eyebrow">Account</p>
      <h1>My Profile</h1>
      <p class="profile-subtitle">Your member details in one place, with quick access to account essentials.</p>
    </div>
    <div class="profile-badge-stack">
      <span class="profile-pill"><%= profile && profile.emailVerified ? 'Email verified' : 'Verification pending' %></span>
      <span class="profile-pill muted">Member since <%= joinedLabel %></span>
    </div>
  </div>

  <div class="profile-grid">
    <aside class="profile-summary-card">
      <div class="profile-avatar"><%= profileInitials %></div>
      <h2><%= profileName %></h2>
      <p><%= profileEmail %></p>

      <div class="profile-stat-list">
        <div class="profile-stat">
          <span class="profile-stat-label">Phone</span>
          <span class="profile-stat-value"><%= profilePhone %></span>
        </div>
        <div class="profile-stat">
          <span class="profile-stat-label">Birthday</span>
          <span class="profile-stat-value"><%= birthdayLabel %></span>
        </div>
      </div>

      <form action="/logout" method="POST" class="profile-logout-form">
        <button type="submit" class="profile-logout-btn">Logout</button>
      </form>
    </aside>

    <div class="profile-detail-panel">
      <div class="profile-card-heading">
        <div>
          <p class="profile-section-kicker">Personal information</p>
          <h3>Account details</h3>
        </div>
        <span class="profile-status-dot <%= profile && profile.emailVerified ? 'is-verified' : '' %>">
          <%= profile && profile.emailVerified ? 'Active' : 'Verify email' %>
        </span>
      </div>

      <div class="profile-detail-grid">
        <div class="profile-detail-card">
          <span class="profile-detail-label">Full name</span>
          <span class="profile-detail-value"><%= profileName %></span>
          <p>Used for your account, order history, and checkout records.</p>
        </div>

        <div class="profile-detail-card">
          <span class="profile-detail-label">Email address</span>
          <span class="profile-detail-value"><%= profileEmail %></span>
          <p>Your sign-in email and the destination for account updates.</p>
        </div>

        <div class="profile-detail-card">
          <span class="profile-detail-label">Phone number</span>
          <span class="profile-detail-value"><%= profilePhone %></span>
          <p>Shown here exactly as saved during signup.</p>
        </div>

        <div class="profile-detail-card">
          <span class="profile-detail-label">Member since</span>
          <span class="profile-detail-value"><%= joinedLabel %></span>
          <p>Tracks when your customer account was created.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 48px 24px 72px;
  }

  .profile-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding: 28px 32px;
    margin-bottom: 28px;
    border: 1px solid rgba(140, 126, 115, 0.12);
    border-radius: 28px;
    background:
      radial-gradient(circle at top left, rgba(195, 163, 124, 0.24), transparent 42%),
      linear-gradient(135deg, rgba(255, 252, 248, 0.96), rgba(245, 239, 232, 0.94));
    box-shadow: 0 22px 40px rgba(92, 72, 54, 0.08);
  }

  .profile-eyebrow {
    margin: 0 0 10px;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9c8a74;
  }

  .profile-hero h1 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 500;
    color: #5b4636;
  }

  .profile-subtitle {
    max-width: 620px;
    margin: 12px 0 0;
    color: #7d6a5c;
    line-height: 1.65;
  }

  .profile-badge-stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .profile-pill {
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(195, 163, 124, 0.32);
    color: #6f5948;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .profile-pill.muted {
    color: #8c7e73;
    border-color: rgba(140, 126, 115, 0.16);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 24px;
  }

  .profile-summary-card,
  .profile-detail-panel {
    border: 1px solid rgba(140, 126, 115, 0.12);
    border-radius: 28px;
    background: #fffdfa;
    box-shadow: 0 18px 36px rgba(111, 89, 72, 0.08);
  }

  .profile-summary-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .profile-avatar {
    width: 84px;
    height: 84px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    background: linear-gradient(135deg, #ccb08a, #a7825a);
    color: #fff;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    box-shadow: 0 16px 28px rgba(167, 130, 90, 0.24);
  }

  .profile-summary-card h2 {
    margin: 0;
    font-size: 1.5rem;
    color: #5b4636;
  }

  .profile-summary-card > p {
    margin: 8px 0 22px;
    color: #8b7767;
  }

  .profile-stat-list {
    width: 100%;
    display: grid;
    gap: 12px;
  }

  .profile-stat {
    padding: 14px 16px;
    border-radius: 18px;
    background: linear-gradient(180deg, #fcf8f3, #f5eee6);
  }

  .profile-stat-label {
