  }

  .profile-logout-btn:hover {
    background: #322821;
    transform: translateY(-1px);
  }

  .profile-detail-panel {
    padding: 28px;
  }

  .profile-card-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
