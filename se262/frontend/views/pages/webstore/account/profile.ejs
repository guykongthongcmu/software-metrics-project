  }

  .profile-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .profile-detail-card {
    padding: 20px;
    border-radius: 22px;
    border: 1px solid rgba(140, 126, 115, 0.1);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 242, 235, 0.9));
  }

  .profile-detail-label {
    display: block;
    margin-bottom: 10px;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #aa9076;
  }

  .profile-detail-value {
    display: block;
    color: #4f3d30;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    word-break: break-word;
  }

  .profile-detail-card p {
    margin: 10px 0 0;
    color: #8a7666;
    line-height: 1.6;
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .profile-hero {
      align-items: flex-start;
      flex-direction: column;
    }

    .profile-badge-stack {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .profile-shell {
      padding: 32px 16px 56px;
    }

    .profile-hero,
    .profile-summary-card,
    .profile-detail-panel {
      border-radius: 22px;
      padding: 22px;
    }

    .profile-detail-grid {
      grid-template-columns: 1fr;
    }

    .profile-card-heading {
      flex-direction: column;
    }
