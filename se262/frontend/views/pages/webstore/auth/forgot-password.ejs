<main class="forgot-pwd-main">
    <div class="forgot-pwd-container">
        <div class="forgot-pwd-header">
            <h1>Forgot Password</h1>
            <p>Please enter the email address you used to create your account and we will send you a link to reset your
                password.</p>
        </div>

        <form class="forgot-pwd-form" action="/auth/forgot-password" method="POST">
            <% if (locals.error) { %>
                <div class="forgot-pwd-error"><%= error %></div>
            <% } %>
            <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" placeholder="name@example.com" value="<%= locals.email || '' %>" required>
            </div>

            <button type="submit" class="forgot-pwd-btn">SUBMIT</button>

            <div class="forgot-pwd-goback-container">
                <a href="/login" class="forgot-pwd-goback">GO BACK</a>
            </div>
        </form>

        <div class="forgot-pwd-copyright">
            &copy; 2026 CORE & CO . ALL RIGHTS RESERVED.
        </div>
    </div>
</main>

<style>
    /* Forget Password Page Specific Styles */
    .forgot-pwd-error {
    background-color: #fdf0ef;
    border: 1px solid #e8b4b0;
    border-radius: 4px;
    padding: 12px 16px;
    font-size: 0.82rem;
    color: #c0392b;
    margin-bottom: 20px;
    text-align: center;
    }
    .forgot-pwd-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .forgot-pwd-container {
        width: 100%;
        max-width: 420px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .forgot-pwd-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .forgot-pwd-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        color: #8c7e73;
    }

    .forgot-pwd-header p {
        color: #a3978f;
        font-size: 0.85rem;
        line-height: 1.6;
        padding: 0 10px;
    }

    .forgot-pwd-form .form-group {
        margin-bottom: 25px;
    }

    .forgot-pwd-form label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #8c7e73;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .forgot-pwd-form input {
        width: 100%;
        padding: 16px 20px;
        border: 1px solid #E6E2DB;
        border-radius: 4px;
        background-color: #FFFFFF;
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        color: #333;
        transition: border-color 0.3s;
    }

    .forgot-pwd-form input::placeholder {
        color: #d1cbc5;
    }

    .forgot-pwd-form input:focus {
        outline: none;
        border-color: #C3A37C;
    }

    .forgot-pwd-btn {
        width: 100%;
        background-color: #C3A37C;
        border: none;
        border-radius: 4px;
        padding: 16px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        color: #333;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color 0.3s;
        font-family: 'Inter', sans-serif;
    }

    .forgot-pwd-btn:hover {
        background-color: #b5946c;
    }

    .forgot-pwd-goback-container {
        text-align: center;
        margin-top: 25px;
    }

    .forgot-pwd-goback {
        font-size: 0.75rem;
        color: #a3978f;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: color 0.3s;
    }

    .forgot-pwd-goback:hover {
        color: #8c7e73;
    }

    .forgot-pwd-copyright {
        text-align: center;
        font-size: 0.65rem;
        color: #b5ac9f;
        margin-top: 80px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>