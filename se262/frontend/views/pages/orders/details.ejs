<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Order <%= order.order_id %>
            </h1>
            <p class="page-subtitle">Order placed on <%= order.created_at %>
            </p>
        </div>
        <a href="/orders" class="btn-glass"><i class="bi bi-arrow-left"></i> Back to Orders</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card-solid" style="padding:24px;margin-bottom:20px;">
                <h5 style="font-size:16px;margin-bottom:16px;">Order Items</h5>
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Size</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(function(item) { %>
                            <tr>
                                <td style="font-weight:500;">
                                    <%= item.product_name %> <span style="color:var(--text-muted);font-size:11px;">
                                            <%= item.sku %>
                                        </span>
                                </td>
                                <td>
                                    <%= item.size %>
                                </td>
                                <td>
                                    <%= item.quantity %>
                                </td>
                                <td>$<%= item.price.toFixed(2) %>
                                </td>
                                <td style="font-weight:600;">$<%= (item.price * item.quantity).toFixed(2) %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" style="text-align:right;font-weight:600;">Total</td>
                            <td style="font-weight:700;font-size:16px;color:var(--golden-straw);">$<%=
                                    order.total.toFixed(2) %>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card-solid" style="padding:24px;margin-bottom:20px;">
                <h5 style="font-size:16px;margin-bottom:16px;">Status</h5>
                <span class="badge-glass badge-<%= order.status.toLowerCase() %>"
                    style="font-size:13px;padding:6px 14px;">
                    <%= order.status %>
                </span>
                <form action="/orders/<%= order.id %>/status" method="POST" style="margin-top:16px;">
                    <label class="glass-label">Update Status</label>
                    <select name="status" class="glass-select" style="margin-bottom:12px;">
                        <% orderStatuses.forEach(function(s) { %>
                            <option value="<%= s %>" <%=order.status===s ? 'selected' : '' %>><%= s %>
                            </option>
                            <% }); %>
                    </select>
                    <button type="submit" class="btn-golden" style="width:100%;justify-content:center;">Update
                        Status</button>
                </form>
            </div>
            <div class="glass-card-solid" style="padding:24px;margin-bottom:20px;">
                <h5 style="font-size:16px;margin-bottom:16px;">Customer</h5>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                    <div
                        style="width:40px;height:40px;border-radius:50%;background:var(--pale-gold);display:flex;align-items:center;justify-content:center;font-weight:600;color:var(--golden-straw);">
                        <%= order.customer_avatar %>
                    </div>
                    <div>
                        <div style="font-weight:600;">
                            <%= order.customer_name %>
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);">
                            <%= order.customer_email %>
                        </div>
                    </div>
                </div>
                <div style="font-size:13px;color:var(--text-secondary);"><i class="bi bi-geo-alt"></i>
                    <%= order.shipping_address %>
                </div>
            </div>
            <div class="glass-card-solid" style="padding:24px;">
                <h5 style="font-size:16px;margin-bottom:16px;">Actions</h5>
                <button class="btn-golden btn-sm" style="width:100%;margin-bottom:8px;justify-content:center;"><i
                        class="bi bi-receipt"></i> Generate Receipt</button>
                <button class="btn-glass btn-sm" style="width:100%;justify-content:center;"><i
                        class="bi bi-envelope"></i> Resend Email</button>
            </div>
        </div>
    </div>
</div>