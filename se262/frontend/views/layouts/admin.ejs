<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title + ' | ' : '' %>Admin Panel
    </title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <!-- Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr" crossorigin="anonymous"></script>
    <link href="/css/app.css" rel="stylesheet">
    <% if (typeof adminAuthPage !=='undefined' && adminAuthPage) { %>
        <link href="/css/login.css" rel="stylesheet">
        <% } else { %>
            <link href="/css/liquid-glass.css" rel="stylesheet">
            <% } %>
                <link rel="icon" type="image/png" href="/images/coreandco.png">

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0" crossorigin="anonymous"></script>
    <!-- CRITICAL: Load global orchestrator before body scripts -->
    <script src="/js/app-admin.js"></script>
</head>

<body>
    <!-- Decorative background for admin pages and auth screen -->
    <div class="liquid-bg-layer" aria-hidden="true">
        <div class="liquid-orb liquid-orb-1"></div>
        <div class="liquid-orb liquid-orb-2"></div>
        <div class="liquid-orb liquid-orb-3"></div>
        <div class="liquid-orb liquid-orb-4"></div>
        <div class="liquid-orb liquid-orb-5"></div>
    </div>

    <% if (typeof adminAuthPage !=='undefined' && adminAuthPage) { %>
        <%- body %>
            <% } else { %>
                <%- include('../partials/admin/sidebar') %>

                    <div class="topbar liquidGL-topbar">
                        <div class="topbar-content"
                            style="position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;width:100%;height:100%;">
                            <div class="topbar-left">
                                <div class="dropdown d-lg-none">
                                    <button class="border-0 bg-transparent p-0" type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false" style="color: var(--golden-straw); cursor:pointer;">
                                        <i class="bi bi-list-nested" style="font-size:24px;"></i>
                                    </button>
                                    <ul class="dropdown-menu shadow-sm"
                                        style="background:rgba(250,248,244,0.97);backdrop-filter:blur(16px);border-radius:14px;border:1px solid rgba(200,167,125,0.25);min-width:220px;padding:8px;">
                                        <li><a class="dropdown-item py-2 rounded-2" href="/admin/dashboard"
                                                style="color:var(--text-primary);"><i class="bi bi-grid-1x2 me-2"
                                                    style="color:var(--golden-straw);"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item py-2 rounded-2" href="/admin/orders"
                                                style="color:var(--text-primary);"><i class="bi bi-cart me-2"
                                                    style="color:var(--golden-straw);"></i>Orders</a></li>
                                        <li><a class="dropdown-item py-2 rounded-2" href="/admin/products"
                                                style="color:var(--text-primary);"><i class="bi bi-bag me-2"
                                                    style="color:var(--golden-straw);"></i>Products</a></li>
                                        <li><a class="dropdown-item py-2 rounded-2" href="/admin/campaigns/builder"
                                                style="color:var(--text-primary);"><i class="bi bi-megaphone me-2"
                                                    style="color:var(--golden-straw);"></i>Campaign Builder</a></li>
                                        <li>
                                            <hr class="dropdown-divider" style="border-color:rgba(200,167,125,0.2);">
                                        </li>
                                        <li><a class="dropdown-item py-2 rounded-2" href="/admin/logout"
                                                style="color:#ff4757;"><i class="bi bi-box-arrow-left me-2"></i>Log
                                                Out</a></li>
                                    </ul>
                                </div>
                                <button class="d-none d-lg-inline-block border-0 bg-transparent p-0" type="button"
                                    id="sidebarToggleBtn" onclick="toggleSidebar()"
                                    style="color: var(--golden-straw); cursor:pointer; margin-right:8px;">
                                    <i class="bi bi-layout-sidebar-inset" style="font-size:20px;"></i>
                                </button>
                                <div class="topbar-breadcrumb"
                                    style="font-size: 16px; font-weight: 500; color: var(--text-primary); margin-left: 12px;">
                                    <%= typeof title !=='undefined' ? title : 'Admin Panel' %>
                                </div>
                            </div>
                            <div class="topbar-right">
                                <div class="topbar-search" style="position:relative;">
                                    <i class="bi bi-search"></i>
                                    <input type="text" id="topbarSearchInput" placeholder="Search pages..."
                                        autocomplete="off" oninput="filterSearchResults(this.value)"
                                        onfocus="showSearchDropdown()"
                                        onblur="setTimeout(()=>hideSearchDropdown(),200)">
                                    <div id="searchDropdown"
                                        style="display:none;position:absolute;top:100%;left:0;width:300px;max-width:calc(100vw - 40px);margin-top:8px;background:rgba(250,248,244,0.97);backdrop-filter:blur(16px);border-radius:12px;border:1px solid rgba(200,167,125,0.25);box-shadow:0 8px 32px rgba(0,0,0,0.12);z-index:1040;overflow:hidden;">
                                        <a href="/admin/dashboard" class="search-result-item"
                                            style="display:flex;align-items:center;gap:10px;padding:10px 16px;text-decoration:none;color:var(--text-primary);font-size:13px;transition:background 0.15s;"><i
                                                class="bi bi-grid-1x2"
                                                style="color:var(--golden-straw);"></i>Dashboard</a>
                                        <a href="/admin/orders" class="search-result-item"
                                            style="display:flex;align-items:center;gap:10px;padding:10px 16px;text-decoration:none;color:var(--text-primary);font-size:13px;transition:background 0.15s;"><i
                                                class="bi bi-cart" style="color:var(--golden-straw);"></i>Orders</a>
                                        <a href="/admin/products" class="search-result-item"
                                            style="display:flex;align-items:center;gap:10px;padding:10px 16px;text-decoration:none;color:var(--text-primary);font-size:13px;transition:background 0.15s;"><i
                                                class="bi bi-bag" style="color:var(--golden-straw);"></i>Products</a>
                                        <a href="/admin/campaigns/builder" class="search-result-item"
                                            style="display:flex;align-items:center;gap:10px;padding:10px 16px;text-decoration:none;color:var(--text-primary);font-size:13px;transition:background 0.15s;"><i
                                                class="bi bi-megaphone" style="color:var(--golden-straw);"></i>Campaign
                                            Builder</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="main-content">
                        <div class="content-wrapper">
                            <%- include('../partials/admin/alerts') %>
                                <%- body %>
                        </div>
                    </div>
                    <% } %>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                    crossorigin="anonymous"></script>
                <% if (typeof adminAuthPage !=='undefined' && adminAuthPage) { %>
                    <script src="/js/login.js?v=20260326"></script>
                <% } %>
</body>

</html>
