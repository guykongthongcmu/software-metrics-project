            <div class="lang-dropdown" id="nav-lang-selector">
                <button class="lang-trigger" id="lang-trigger-btn" aria-haspopup="true" aria-expanded="false">
                    <span class="lang-current">EN</span>
                    <svg class="nav-icon-small lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7">
                        </path>
                    </svg>
                </button>
                <ul class="lang-menu" role="menu">
                    <li role="menuitem"><button class="lang-option" data-lang="en">EN</button></li>
                    <li role="menuitem"><button class="lang-option" data-lang="th">TH</button></li>
                </ul>
            </div>
            <script>
                (function () {
                    /* ── Language selector ── */
                    const dropdown = document.getElementById('nav-lang-selector');
                    const trigger = document.getElementById('lang-trigger-btn');
                    const current = dropdown.querySelector('.lang-current');
                    const options = dropdown.querySelectorAll('.lang-option');

                    trigger.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const isOpen = dropdown.classList.toggle('open');
                        trigger.setAttribute('aria-expanded', isOpen);
                    });

                    options.forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            current.textContent = btn.dataset.lang.toUpperCase();
                            dropdown.classList.remove('open');
                            trigger.setAttribute('aria-expanded', 'false');
                        });
                    });

                    document.addEventListener('click', function () {
                        dropdown.classList.remove('open');
                        trigger.setAttribute('aria-expanded', 'false');
                    });

                    /* ── Mega dropdowns ── */
                    const navbar = document.getElementById('main-navbar');

                    function getNavbarHeight() {
                        return navbar ? navbar.getBoundingClientRect().height : 90;
                    }

                    function makeMegaDropdown(triggerId, panelId, closeId) {
                        const trigger = document.getElementById(triggerId);
                        const panel = document.getElementById(panelId);
                        const closeBtn = document.getElementById(closeId);
                        const overlay = document.getElementById('mega-overlay');
                        if (!trigger || !panel) return;

                        /* Set panel top to sit flush under navbar */
                        function positionPanel() {
                            panel.style.top = getNavbarHeight() + 'px';
                        }
                        positionPanel();
                        window.addEventListener('resize', positionPanel);

                        let timer = null;

                        function show() {
                            clearTimeout(timer);
                            panel.style.display = 'block';
                            if (overlay) overlay.style.display = 'block';
                        }

                        function scheduleHide() {
                            timer = setTimeout(function () {
                                panel.style.display = 'none';
                                if (overlay) overlay.style.display = 'none';
                            }, 100);
                        }

                        trigger.addEventListener('mouseenter', show);
                        trigger.addEventListener('mouseleave', scheduleHide);
                        panel.addEventListener('mouseenter', show);
                        panel.addEventListener('mouseleave', scheduleHide);

                        if (closeBtn) {
                            closeBtn.addEventListener('click', function () {
                                clearTimeout(timer);
                                panel.style.display = 'none';
                                if (overlay) overlay.style.display = 'none';
                            });
                        }
                    }

                    makeMegaDropdown('mega-men-trigger', 'mega-men-panel', 'mega-men-close');
                    makeMegaDropdown('mega-women-trigger', 'mega-women-panel', 'mega-women-close');
                    makeMegaDropdown('mega-kids-trigger', 'mega-kids-panel', 'mega-kids-close');
                    makeMegaDropdown('mega-baby-trigger', 'mega-baby-panel', 'mega-baby-close');
                    makeMegaDropdown('mega-unisex-trigger', 'mega-unisex-panel', 'mega-unisex-close');
                })();
            </script>
