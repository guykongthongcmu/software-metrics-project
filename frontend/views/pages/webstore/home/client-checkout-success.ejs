<% layout = 'layouts/webstore' %>
<link rel="stylesheet" href="/css/client-checkoutStyle.css" />

<style>
  .success-page {
    background: var(--ck-bg);
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
  }

  .success-card {
    text-align: center;
    max-width: 480px;
    width: 100%;
    animation: ckFadeUp 0.5s ease both;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border: 1.5px solid var(--ck-gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    color: var(--ck-gold);
    animation: successPop 0.5s 0.2s ease both;
  }

  .success-label {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ck-muted);
    margin-bottom: 12px;
  }

  .success-title {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    font-weight: 400;
    color: var(--ck-text);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .success-desc {
    font-size: 0.82rem;
    color: var(--ck-muted);
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .success-order-num {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ck-muted);
    margin-bottom: 32px;
  }
  .success-order-num span {
    color: var(--ck-gold);
    font-weight: 600;
  }

  .success-divider {
    width: 40px;
    height: 1px;
    background: var(--ck-border);
    margin: 0 auto 32px;
  }

  .success-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .success-btn-primary {
    display: block;
    width: 100%;
    height: 48px;
    background: var(--ck-gold);
    color: #fff;
    border: none;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    font-family: inherit;
  }
  .success-btn-primary:hover {
    background: var(--ck-gold-h);
    color: #fff;
  }

  .success-btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    background: transparent;
    color: var(--ck-text);
    border: 1px solid var(--ck-border);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.15s;
    font-family: inherit;
  }
  .success-btn-secondary:hover {
    border-color: var(--ck-gold);
    color: var(--ck-text);
  }

  @keyframes successPop {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<div class="success-page">
  <div class="success-card">
    <div class="success-icon">
      <svg
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        width="26"
        height="26"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M5 13l4 4L19 7"
        />
      </svg>
    </div>

    <p class="success-label">Order Confirmed</p>
    <h1 class="success-title">Thank you for<br />your purchase</h1>
    <p class="success-desc">
      Your order has been placed successfully.<br />
      We'll send you a confirmation email shortly.
    </p>

    <p class="success-order-num">
      Order number: <span id="successOrderNum">#—</span>
    </p>

    <div class="success-divider"></div>

    <div class="success-actions">
      <a href="/" class="success-btn-primary">Continue Shopping</a>
      <a href="/account/profile" class="success-btn-secondary"
        >View My Profile</a
      >
    </div>
  </div>
</div>

<script>
  // generate mock order number
  var orderNum = "#" + Math.floor(100000 + Math.random() * 900000);
  var el = document.getElementById("successOrderNum");
  if (el) el.textContent = orderNum;
</script>
