<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Promotional Campaign Builder</h1>
            <p class="page-subtitle">Design, schedule, and launch marketing campaigns across platforms</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Live Preview / Summary (Moved Top) -->
        <div class="col-12">
            <div class="section-title mb-3" style="font-size: 16px; font-weight: 600; color: var(--text-primary);">
                Campaign Preview
            </div>

            <div class="glass-card-solid" style="padding: 24px;">
                <div id="previewCard"
                    style="border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); position: relative; min-height: 200px; background: #222;">
                    <!-- Media Layer -->
                    <div id="previewMedia"
                        style="position: absolute; inset: 0; background: linear-gradient(135deg, #f1c40f, #e67e22); z-index: 1; display: flex; align-items: center; justify-content: center;">
                        <img id="previewImg" src=""
                            style="width: 100%; height: 100%; object-fit: cover; display: none;">
                        <video id="previewVideo" autoplay muted loop
                            style="width: 100%; height: 100%; object-fit: cover; display: none;"></video>
                    </div>

                    <!-- Content Layer -->
                    <div
                        style="position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px;">
                        <h3 id="previewTitle"
                            style="font-family: 'DM Serif Display', serif; font-size: 28px; color: white; margin-bottom: 10px; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                            Your Sale Name</h3>
                        <div class="campaign-preview-meta" style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="badge-glass" id="previewType"
                                style="background: white; color: black; border: none; font-weight: 700;">Discount
                                Type</span>
                            <span style="font-size: 11px; color: rgba(255,255,255,0.9); font-weight: 500;"
                                id="previewDates">Dates will appear here</span>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 24px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span style="font-size: 13px; color: var(--text-muted);"></span>
                        <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);"></span>
                    </div>
                    <div class="progress-glass" style="height: 6px;">
                        <div class="progress-bar-glass" style="width: 75%; background: var(--golden-straw);"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Campaign Form -->
        <div class="col-12">
            <div class="glass-card-solid" style="padding: 30px;">
                <form id="campaignForm">
                    <!-- Campaign Details -->
                    <div class="form-section mb-4">
                        <label class="form-label-glass">Campaign Name</label>
                        <input type="text" class="glass-input" id="campaignName" placeholder="e.g., Summer Flash Sale"
                            required>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label-glass">Offer Type</label>
                            <select class="glass-input" id="offerType" required>
                                <option value="" disabled selected>Select offer type</option>
                                <option value="PERCENTAGE_DISCOUNT">Percentage Discount (%)</option>
                                <option value="FIXED_AMOUNT_DISCOUNT">Fixed Amount Discount ($)</option>
                                <option value="BEST_SELLER">Best Seller</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="discountValueWrapper">
                            <label class="form-label-glass">Discount Value</label>
                            <input type="number" class="glass-input" id="discountValue" placeholder="e.g., 20">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-glass">Campaign Scheduled Duration</label>
                        <div class="input-group-glass">
                            <i class="bi bi-calendar-range me-2 text-muted"></i>
                            <input type="text" class="glass-input" id="campaignDuration" placeholder="Select Start & End Dates" required>
                        </div>
                    </div>

                    <!-- Campaign Media -->
                    <div class="mb-4">
                        <label class="form-label-glass">Campaign Cover (Image or Video)</label>
                        <div id="dropZone" class="glass-drop-zone">
                            <input type="file" id="mediaUpload" class="d-none" accept="image/*,video/*">
                            <div class="drop-zone-content">
                                <i class="bi bi-cloud-arrow-up"
                                    style="font-size: 32px; color: var(--golden-straw);"></i>
                                <p style="margin: 8px 0 4px; font-size: 14px; color: var(--text-primary);">Drag & Drop
                                    or Click to Upload</p>
                                <p style="font-size: 11px; color: var(--text-muted);">Supports Image (JPG, PNG) or Video
                                    (MP4)</p>
                            </div>
                        </div>
                        <div id="uploadFeedback" class="mt-2"
                            style="display: none; align-items: center; gap: 10px; padding: 8px 12px; background: rgba(255,255,255,0.4); border-radius: 8px; border: 1px solid rgba(215,205,190,0.3);">
                            <i id="feedbackIcon" class="bi bi-file-earmark-image"></i>
                            <span id="feedbackName"
                                style="font-size: 12px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;">filename.png</span>
                            <button type="button" class="btn-glass btn-sm" onclick="clearUpload()"
                                style="padding: 2px 6px;"><i class="bi bi-x"></i></button>
                        </div>

                    </div>

                    <!-- Distribution Channels -->
                    <div class="mb-4">
                        <label class="form-label-glass mb-3">Distribution Channels</label>
                        <div class="channel-grid">
                            <div class="channel-item">
                                <input type="checkbox" id="chanWeb" class="channel-check" checked>
                                <label for="chanWeb" class="channel-label">
                                    <i class="bi bi-browser-safari"></i>
                                    <span>Web Banner</span>
                                </label>
                            </div>
                            <div class="channel-item">
                                <input type="checkbox" id="chanEmail" class="channel-check">
                                <label for="chanEmail" class="channel-label">
                                    <i class="bi bi-envelope"></i>
                                    <span>Email blast</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 40px;">
                        <button type="submit" class="btn-golden w-100 py-3">
                            <i class="bi bi-rocket-takeoff"></i> Launch Campaign
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Same Modals as before... -->
    <!-- Launch Confirmation Modal -->
    <div class="modal fade" id="launchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card-solid"
                style="background: rgba(255,255,255,0.95); border: 1px solid white;">
                <div class="modal-body text-center" style="padding: 40px 30px;">
                    <div id="launchInitial">
                        <div
                            style="width: 70px; height: 70px; border-radius: 50%; background: rgba(241, 196, 15, 0.1); color: var(--golden-straw); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 32px;">
                            <i class="bi bi-question-lg"></i>
                        </div>
                        <h4 style="font-weight: 600; color: var(--text-primary);">Ready to launch?</h4>
                        <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 30px;">
                            The campaign <strong id="confirmCampName"></strong> will go live immediately on all selected
                            channels.
                        </p>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn-glass flex-grow-1" data-bs-dismiss="modal">Go back</button>
                            <button type="button" class="btn-golden flex-grow-1" id="confirmLaunchBtn">Confirm &
                                Launch</button>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div id="launchLoading" style="display: none;">
                        <div class="spinner-border text-warning" role="status"
                            style="width: 3rem; height: 3rem; margin-bottom: 24px;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h4 style="font-weight: 600; color: var(--text-primary);">Launching Campaign...</h4>
                        <p style="color: var(--text-secondary); font-size: 14px;">Contacting distribution servers...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-label-glass {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            display: block;
            margin-bottom: 8px;
        }

        .text-primary-glass {
            color: var(--text-primary);
        }

        .channel-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
        }

        .channel-check {
            display: none;
        }

        .channel-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 16px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.3s;
        }

        .channel-label i {
            font-size: 24px;
            color: var(--text-muted);
        }

        .channel-label span {
            font-size: 12px;
            color: var(--text-secondary);
            text-align: center;
        }

        .channel-check:checked+.channel-label {
            background: rgba(241, 196, 15, 0.08);
            border-color: var(--golden-straw);
        }

        .channel-check:checked+.channel-label i {
            color: var(--golden-straw);
        }

        .channel-check:checked+.channel-label span {
            color: var(--text-primary);
            font-weight: 600;
        }

        .glass-input:focus {
            border-color: var(--golden-straw);
            box-shadow: 0 0 10px rgba(241, 196, 15, 0.2);
        }

        .glass-drop-zone {
            border: 2px dashed rgba(215, 205, 190, 0.4);
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            background: rgba(255, 255, 255, 0.05);
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .glass-drop-zone:hover,
        .glass-drop-zone.dragover {
            border-color: var(--golden-straw);
            background: rgba(200, 167, 125, 0.05);
            transform: translateY(-2px);
        }

        .glass-drop-zone i {
            transition: transform 0.3s ease;
        }

        .glass-drop-zone:hover i {
            transform: translateY(-5px);
        }

        .input-group-glass {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 0 16px;
            transition: all 0.3s;
        }

        .input-group-glass:focus-within {
            border-color: var(--golden-straw);
            box-shadow: 0 0 10px rgba(241, 196, 15, 0.2);
        }

        .input-group-glass .glass-input {
            border: none !important;
            background: transparent !important;
            box-shadow: none !important;
            padding-left: 8px;
        }

        .glass-selection-box::-webkit-scrollbar {
            width: 6px;
        }
        .glass-selection-box::-webkit-scrollbar-thumb {
            background: rgba(241, 196, 15, 0.3);
            border-radius: 10px;
        }

        @media (max-width: 767.98px) {
            #previewTitle {
                font-size: 22px !important;
            }

            .campaign-preview-meta,
            #launchInitial .d-flex.gap-3 {
                flex-direction: column;
                align-items: flex-start !important;
            }

            #launchInitial .d-flex.gap-3 .btn-glass,
            #launchInitial .d-flex.gap-3 .btn-golden {
                width: 100%;
                justify-content: center;
            }

            #uploadFeedback {
                flex-wrap: wrap;
            }
        }
    </style>

    <script src="/js/campaign-builder.js"></script>
</div>
